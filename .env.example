# Copy to .env: `cp .env.example .env`.
# Change the passwords for anything but a local run.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=price_tracker

# Redis: the Celery broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Port docker compose publishes the API on
API_PORT=8000

# What to collect and how often
COLLECTOR_TICKERS='["btc_usd", "eth_usd"]'
COLLECTOR_INTERVAL_SECONDS=60
COLLECTOR_MAX_RETRIES=3

# Deribit public API
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_REQUEST_TIMEOUT_SECONDS=10
